grammar org.xtext.example.mydsl.MyDsl with org.eclipse.xtext.common.Terminals

generate myDsl "http://www.xtext.org/example/mydsl/MyDsl"

Config:
    'config' name=ID  entries+=Entry*
;
    
Entry: 
	name=ID':' (type=Exp | '{' entries+=Entry* '}')
;    
    

Exp:
	Constraint ({And.left=current} '&&' right=Exp)?
;
    
And:
	left=(Constraint) ('&&' right=Exp)?
;

Constraint:
    (IntConstraint | StringConstraint | BoolConstraint | IPConstraint | Requirement)
;

IntConstraint:
    {IntConstraint} 'Int' (constraint=('<' | '>' | '<=' | '>=' | '!=' | '=') value=Expression)?
;

StringConstraint:
    {StringConstraint} 'String' (constraint=('!=' | '=') value=Expression)?
;

BoolConstraint:
    {BoolConstraint} 'Bool' (constraint=('!=' | '=') value=Expression)?
;

Expression:
	Term (({Plus.left=current} '+' | {Minus.left=current} '-') right=Term)*
;

Term:
	Primary (({Mult.left=current} '*' | {Div.left=current} '/') right=Primary)*
;

Primary:
	Number | Str | Bool | PropertyReference
;

Number:
	value=INT
;

Str:
	value=STRING
;

// {Bool} Force Bool class to always be instantiated, 
// since xtext match true/false keywords without instantiating the class otherwise
Bool:
	{Bool} value=('true' | 'false')
;

PropertyReference:
	ref=[Entry|NestedReference]
;

NestedReference:
	ID ('.' ID)*
;

IPConstraint:
    {IPConstraint} 'IP' (constraint=('<' | '>' | '<=' | '>=' | '!=' | '=') value=TermIP)?
;


TermIP:
	INT'.'INT'.'INT'.'INT | 'localhost'
;

Requirement:
	'requires' ref=[Entry]
;
